  "components": [
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The principal action on paper, with a trailing ink arrow.",
      "html": "<button class=\"ds-primary\">Begin your journey <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 19 19 5M6 5h13v13\"/></svg></button>",
      "css": ".ds-primary{display:flex;align-items:center;justify-content:space-between;gap:38px;background:var(--rust,#a24932);color:#fff9eb;border:0;border-radius:5px;min-height:51px;padding:14px 20px;font:12px var(--sans,\"Memory Sans\",sans-serif);letter-spacing:.025em;text-align:left;cursor:pointer;transition:background .2s,transform .3s cubic-bezier(.16,1,.3,1)}.ds-primary svg{width:18px;height:18px;flex-shrink:0}.ds-primary:hover{background:#853c2a;transform:translateY(-2px)}.ds-primary:focus-visible{outline:2px solid var(--rust,#a24932);outline-offset:5px;}.ds-primary:disabled{opacity:.6;cursor:wait}"
    },
    {
      "name": "Text action",
      "kind": "button",
      "refersTo": "button-text",
      "description": "A quieter action with a fine offset underline.",
      "html": "<button class=\"ds-text-action\">Continue your journey</button>",
      "css": ".ds-text-action{border:0;padding:10px 0;background:none;color:var(--ink,#354338);font:12px var(--sans,\"Memory Sans\",sans-serif);text-align:left;text-decoration:underline;text-underline-offset:5px;text-decoration-color:#8d826070;cursor:pointer}.ds-text-action:hover{color:var(--rust,#a24932);text-decoration-color:var(--rust,#a24932)}.ds-text-action:focus-visible{outline:2px solid var(--rust,#a24932);outline-offset:5px;}"
    },
    {
      "name": "Character name",
      "kind": "input",
      "refersTo": "field-name",
      "description": "A labelled, lightly translucent name field.",
      "html": "<label class=\"ds-name-label\" for=\"ds-name\">Your character’s name</label><input id=\"ds-name\" class=\"ds-name\" placeholder=\"A name to come home to\" maxlength=\"24\" />",
      "css": ".ds-name-label{display:block;font:500 11px var(--sans,\"Memory Sans\",sans-serif);color:var(--ink,#354338);margin-bottom:11px}.ds-name{width:100%;background:rgba(255,253,244,.65);border:1px solid #b7b8a5;border-radius:4px;padding:13px 12px;font:13px var(--sans,\"Memory Sans\",sans-serif);color:var(--ink,#354338);caret-color:var(--rust,#a24932)}.ds-name::placeholder{color:#73745e}.ds-name:focus-visible{outline:2px solid var(--rust,#a24932);outline-offset:5px;}"
    },
    {
      "name": "World tool navigation",
      "kind": "nav",
      "refersTo": "button-round",
      "description": "Circular journal control representing the vertical world-tool navigation.",
      "html": "<nav class=\"ds-tools\" aria-label=\"World tools\"><button class=\"ds-round\" aria-label=\"Memory journal\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 6C9 4 5 4 3 5v14c3-1 6-1 9 1 3-2 6-2 9-1V5c-2-1-6-1-9 1Zm0 0v14M6 8h3m-3 3h3m6-3h3m-3 3h3\"/></svg><small>Journal</small></button></nav>",
      "css": ".ds-tools{padding-left:70px}.ds-round{position:relative;width:43px;height:43px;border:1px solid #d9d2b2;background:#f4ecddeb;color:var(--ink,#354338);border-radius:50%;display:grid;place-items:center;cursor:pointer;transition:background .2s,transform .2s}.ds-round svg{width:20px;height:20px;stroke-width:1.5}.ds-round small{position:absolute;right:46px;white-space:nowrap;font:9px var(--sans,\"Memory Sans\",sans-serif);background:#f4ecddd9;padding:5px 8px;border-radius:3px;color:#344432}.ds-round:hover{background:#fff8e8;transform:translateY(-2px)}.ds-round:focus-visible{outline:2px solid var(--rust,#a24932);outline-offset:5px;}"
    },
    {
      "name": "Paper panel",
      "kind": "card",
      "refersTo": "paper-dialog",
      "description": "The shared paper-dialog surface, shown as a static panel for preview.",
      "html": "<section class=\"ds-paper\"><h2>Little things,<br><em>kept forever.</em></h2><p>Your memories of Jiufen, one familiar feeling at a time.</p></section>",
      "css": ".ds-paper{width:520px;max-width:100%;padding:42px;background:var(--paper,#f3eddf);color:var(--ink,#354338);border-radius:9px;box-shadow:0 24px 90px #14282044}.ds-paper h2{margin:0;font:500 47px/.95 var(--serif,\"Memory Serif\",Georgia,serif);letter-spacing:-.025em}.ds-paper em{font-weight:400;color:var(--rust,#a24932)}.ds-paper p{margin:18px 0 0;font:12px/1.7 var(--sans,\"Memory Sans\",sans-serif);color:var(--soft,#626a55)}"
    },
    {
      "name": "Journal entry",
      "kind": "custom",
      "description": "An actual collected-memory row, using the project’s ticket icon and first memory.",
      "html": "<button class=\"ds-entry\"><span class=\"ds-entry-icon\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 6h16v4c-3 0-3 4 0 4v4H4v-4c3 0 3-4 0-4ZM15 6v2m0 2v2m0 2v2m0 1v1M7 9h5m-5 3h4m-4 3h5\"/></svg></span><span><strong>One more bend</strong><small>The old bus stop</small></span><span class=\"ds-entry-arrow\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 19 19 5M6 5h13v13\"/></svg></span></button>",
      "css": ".ds-entry{display:flex;align-items:center;gap:15px;padding:16px 0;width:100%;text-align:left;border:0;border-bottom:1px solid var(--line,#cdc9b6);background:none;color:var(--ink,#354338);cursor:pointer}.ds-entry-icon{width:40px;height:40px;display:grid;place-items:center;color:var(--rust,#a24932);flex-shrink:0}.ds-entry-icon svg{width:27px;height:27px;stroke-width:1.3}.ds-entry strong{font:600 22px var(--serif,\"Memory Serif\",Georgia,serif);display:block}.ds-entry small{display:block;font:10px/1.5 var(--sans,\"Memory Sans\",sans-serif);color:var(--soft,#626a55);margin-top:3px}.ds-entry-arrow{margin-left:auto}.ds-entry-arrow svg{width:16px;height:16px}.ds-entry:focus-visible{outline:2px solid var(--rust,#a24932);outline-offset:5px;}"
    },
    {
      "name": "Memory progress",
      "kind": "custom",
      "description": "Six petal-like marks; warm fill distinguishes collected memories.",
      "html": "<div class=\"ds-memory-progress\" aria-label=\"Two of six memories\"><span aria-hidden=\"true\"><i class=\"ds-found\"></i><i class=\"ds-found\"></i><i></i><i></i><i></i><i></i></span><small>2 / 6 memories</small></div>",
      "css": ".ds-memory-progress{display:flex;flex-direction:column;gap:9px;color:#f3eddf;text-shadow:0 1px 6px #253a2f;padding:16px;background:#354338}.ds-memory-progress>span{display:flex;gap:6px}.ds-memory-progress i{width:11px;height:11px;border:1px solid #f6e4b1;transform:rotate(45deg);border-radius:50% 50% 0 50%}.ds-memory-progress i.ds-found{background:#f3cc7a}.ds-memory-progress small{font:10px var(--sans,\"Memory Sans\",sans-serif)}"
    }
  ],
  "narrative": {
    "northStar": "The way home",
    "overview": "The way home pairs a living hillside with the quiet material of a kept letter. Jiufen's steep stone lanes, stacked tea houses, Traditional Chinese signs, red lanterns and distant mountain ridges establish the place. Warm, vibrant architecture carries the scene; ivory paper and small ink controls give the traveller room to explore.\n\nThe confirmed visual authority is the user's Jiufen moodboard and Sakura Peak reference, implemented directly in Three.js. There is no approved generated design comp. Geometry, weathered canvas textures, signs, SVG icons and ambient audio are authored in code. The current world is a finite, compressed neighbourhood with six fictional memories and an intentionally generic placeholder character. These are prototype constraints, not claims of geographic completeness or a finished character-art system.",
    "keyCharacteristics": [
      "Warm terracotta, ochre and plaster façades framed by burgundy timber.",
      "Amber light, peach haze and rose-toned dusk; green concentrated in foliage.",
      "Expressive serif titles, readable serif memory passages and restrained sans-serif controls.",
      "Full-viewport exploration with quiet edge controls and layered paper dialogs.",
      "Original line icons and a recurring petal-shaped memory marker."
